# DeepSeek API Configuration
# Leave empty to use built-in deterministic Mastra rule-guided provider (great for offline dev & CI testing)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Database (LibSQL / local SQLite)
DATABASE_URL=file:./data/presales-copilot.db

# Server
PORT=3000
HOST=0.0.0.0
